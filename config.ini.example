[videos]
; URL path where Nginx serves the player release. Use / for a dedicated host.
site_url_prefix=/vr-player
; Filesystem directory Nginx serves at videos_url_prefix.
videos_path=/mnt/hdd/videos
; Filesystem directory Nginx serves at thumbnails_url_prefix.
thumbnails_path=/mnt/hdd/thumbnails
; Media mounts below site_url_prefix. These must start with /.
videos_url_prefix=/media
thumbnails_url_prefix=/thumbnails
