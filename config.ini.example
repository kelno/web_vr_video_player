[library]
; Local paths used by the Python catalogue/thumbnail tools and npm run dev.
videos_path=/mnt/hdd/videos
thumbnails_path=/mnt/hdd/thumbnails

[web]
; Browser and Nginx URL contract. These values contain no local filesystem paths.
; site_url_prefix is where Nginx serves dist/. Use / for a dedicated host.
site_url_prefix=/vr-player
; Media mounts below site_url_prefix. These must start with /.
videos_url_prefix=/media
thumbnails_url_prefix=/thumbnails

[player]
; Initial SBS screen zoom, from 0 (base size) through 180.
; Rebuild the browser bundle after changing player settings.
default_sbs_zoom=100
